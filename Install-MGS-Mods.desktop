[Desktop Entry]
Type=Application
Version=1.0
Name=MGS Master Collection Mod Kit
Comment=Install, repair or remove vanilla-faithful mods for MGS1, MGS2 & MGS3 Master Collection on Steam Deck / SteamOS. Keep this shortcut — it does all three.
Icon=package-x-generic
Terminal=true
Exec=bash -c 'TAG=v2.1.0; SHA=096b35317e042a4e323b0eef52ab41c8bfc3cdbc13a9267ecd167704fe949479; URL=https://github.com/cntrl-alt-lenny/mgs-mc-modkit/releases/download/$TAG/install.py; F=$(mktemp /tmp/mgs_install.XXXXXX.py); echo "Fetching the MGS Mod Kit installer ($TAG)..."; if curl -fsSL "$URL" -o "$F" && echo "$SHA  $F" | sha256sum -c --status -; then python3 "$F"; else echo; echo "Could not download or verify the installer. Nothing was changed."; echo "Check your internet connection and try again."; fi; rm -f "$F"; echo; echo "Press Enter to close this window."; read'
Categories=Game;Utility;
