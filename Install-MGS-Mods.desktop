[Desktop Entry]
Type=Application
Version=1.0
Name=MGS Master Collection Mod Kit
Comment=Install, repair or remove vanilla-faithful mods for MGS1, MGS2 & MGS3 Master Collection on Steam Deck / SteamOS. Keep this shortcut — it does all three.
Icon=applications-games
Terminal=true
Exec=bash -c 'TAG=v1.7.0; SHA=4e65ccf549fbfcfd507af1e6a57fb7683702b6eb2956bb40150d24b07ed369f1; URL=https://github.com/cntrl-alt-lenny/mgs-mc-deck-modkit/releases/download/$TAG/install.py; F=/tmp/mgs_install.py; if curl -fsSL "$URL" -o "$F" && echo "$SHA  $F" | sha256sum -c --status -; then python3 "$F" --desktop "%k"; else echo; echo "Installer download or SHA-256 verification FAILED — nothing was run. (Is release $TAG published?)"; fi; echo; echo "Press Enter to close."; read'
Categories=Game;Utility;
