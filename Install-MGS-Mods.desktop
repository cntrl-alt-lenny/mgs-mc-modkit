[Desktop Entry]
Type=Application
Version=1.0
Name=MGS Master Collection Mod Kit
Comment=Install, repair or remove vanilla-faithful mods for MGS1, MGS2 & MGS3 Master Collection on Steam Deck / SteamOS. Keep this shortcut — it does all three.
Icon=applications-games
Terminal=true
Exec=bash -c 'TAG=v1.11.0; SHA=06c2a4772ee566fa3bc9a3a095f77216d0dc5d58bc743b1122ca7fa13a4d77de; URL=https://github.com/cntrl-alt-lenny/mgs-mc-deck-modkit/releases/download/$TAG/install.py; F=$(mktemp /tmp/mgs_install.XXXXXX.py); echo "Fetching the MGS Mod Kit installer ($TAG)..."; if curl -fsSL "$URL" -o "$F" && echo "$SHA  $F" | sha256sum -c --status -; then python3 "$F"; else echo; echo "Could not download or verify the installer. Nothing was changed."; echo "Check your internet connection and try again."; fi; rm -f "$F"; echo; echo "Press Enter to close this window."; read'
Categories=Game;Utility;
